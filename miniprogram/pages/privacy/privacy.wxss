.page { padding: 28rpx 28rpx 48rpx; }
.title { font-size: 36rpx; font-weight: 600; color: #5a4a3a; }
.updated { margin-top: 10rpx; color: #a89a8a; font-size: 22rpx; }
.section { margin-top: 32rpx; }
.heading { margin-bottom: 10rpx; font-size: 28rpx; font-weight: 600; color: #5a4a3a; }
.body { color: #786b5e; font-size: 25rpx; line-height: 1.8; }
.email { color: #8a704d; }
.contact { padding-bottom: 16rpx; }
.privacy-link { margin: 28rpx 0; padding: 0; background: transparent; color: #8a704d; font-size: 25rpx; text-align: left; }
.privacy-link::after, .decline::after { border: 0; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; margin: 0; font-size: 27rpx; }
.decline { background: #f1ece5; color: #786b5e; border-radius: 12rpx; }
.agree { padding: 18rpx 0; }
