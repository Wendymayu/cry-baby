.page { padding: 24rpx; padding-bottom: 56rpx; }
.retention-card { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; border: 1rpx solid #ede4d8; border-radius: 18rpx; background: #f5efe6; }
.retention-mark { flex: none; width: 68rpx; height: 68rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: #a68a64; color: #fff; font-size: 27rpx; font-weight: 700; }
.retention-copy { display: flex; flex-direction: column; gap: 9rpx; }
.retention-title { color: #5a4a3a; font-size: 27rpx; font-weight: 600; }
.retention-desc { color: #8f7d69; font-size: 22rpx; line-height: 1.55; }
.list-heading { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 4rpx 18rpx; }
.heading-title { color: #5a4a3a; font-size: 30rpx; font-weight: 600; }
.heading-count { color: #a89a8a; font-size: 24rpx; }
.trash-list { display: flex; flex-direction: column; gap: 18rpx; }
.trash-card { padding: 20rpx; border: 1rpx solid #f0ece6; border-radius: 18rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(64, 48, 32, 0.035); }
.item-main { display: flex; gap: 20rpx; min-height: 164rpx; }
.item-photo { flex: none; width: 142rpx; height: 164rpx; border-radius: 12rpx; background: #f5f1ea; }
.item-swatch { border: 1rpx solid #f0ece6; box-sizing: border-box; }
.item-info { min-width: 0; flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding: 5rpx 0; }
.info-top { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.category { color: #5a4a3a; font-size: 29rpx; font-weight: 600; }
.remaining { flex: none; padding: 7rpx 12rpx; border-radius: 20rpx; background: #fbf4e8; color: #a1763f; font-size: 21rpx; }
.color-line { display: flex; align-items: center; gap: 10rpx; margin-top: 17rpx; color: #786b5e; font-size: 23rpx; }
.color-dot { width: 22rpx; height: 22rpx; border: 1rpx solid rgba(0,0,0,0.08); border-radius: 50%; }
.remark { width: 100%; margin-top: 12rpx; color: #8f7d69; font-size: 22rpx; }
.expires { margin-top: auto; color: #b2a89d; font-size: 20rpx; }
.item-actions { display: flex; gap: 14rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #f2eee9; }
.item-actions button { flex: 1; height: 68rpx; line-height: 68rpx; margin: 0; padding: 0 12rpx; border-radius: 10rpx; font-size: 24rpx; }
.restore-button { background: #a68a64; color: #fff; }
.restore-button[disabled] { opacity: 0.55; }
.permanent-button { background: #fff; border: 1rpx solid #ead8d3; color: #b34f43; }
.permanent-button[disabled] { opacity: 0.5; }
.state-card { display: flex; flex-direction: column; align-items: center; margin-top: 28rpx; padding: 76rpx 32rpx; border: 1rpx solid #f0ece6; border-radius: 18rpx; background: #fff; text-align: center; }
.state-icon, .empty-icon { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f4eee5; color: #a68a64; font-size: 38rpx; font-weight: 600; }
.empty-icon { color: #6b9d73; background: #edf5ec; }
.state-title { margin-top: 20rpx; color: #5a4a3a; font-size: 28rpx; font-weight: 600; }
.state-desc { margin-top: 12rpx; color: #a89a8a; font-size: 23rpx; line-height: 1.6; }
.retry-button { width: 220rpx; height: 68rpx; margin-top: 26rpx; line-height: 68rpx; border-radius: 10rpx; background: #a68a64; color: #fff; font-size: 24rpx; }
