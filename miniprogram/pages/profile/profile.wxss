.page { padding: 24rpx; }
.section-title { margin: 12rpx 8rpx 16rpx; color: #8f7d69; font-size: 25rpx; font-weight: 600; }
.settings-title { margin-top: 30rpx; }
.field { background: #fff; border: 1rpx solid #f0ece6; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #a89a8a; margin-bottom: 12rpx; }
.input { padding: 16rpx; background: #faf8f5; border-radius: 8rpx; margin-bottom: 16rpx; }
.save { width: 200rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; border: 1rpx solid #f0ece6; border-radius: 16rpx;
  padding: 28rpx 24rpx; margin-bottom: 16rpx;
}
.arrow { color: #a89a8a; }
.trash-entry { min-height: 104rpx; }
.trash-entry-main { display: flex; align-items: center; gap: 20rpx; }
.trash-icon { width: 68rpx; height: 68rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: #f4eee5; color: #a68a64; font-size: 30rpx; font-weight: 600; }
.trash-copy { display: flex; flex-direction: column; gap: 8rpx; }
.trash-title { color: #5a4a3a; font-size: 29rpx; }
.trash-hint { color: #a89a8a; font-size: 22rpx; }
.delete-row { color: #b34f43; }
.about { justify-content: center; color: #a89a8a; font-size: 24rpx; }
