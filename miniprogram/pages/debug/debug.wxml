<view class="container">
  <view class="hint">后端地址:{{baseUrl}}</view>

  <button type="primary" bindtap="testHealth">1. 测连通 GET /health</button>
  <view class="result">{{health || '(点上方按钮)'}}</view>

  <button type="primary" bindtap="login">2. 登录 POST /api/auth/login</button>
  <view class="result token">token:{{token || '(未登录)'}}</view>

  <button type="warn" bindtap="fetchDevToken">2b. 一键获取调试 token(游客绕过)</button>

  <view class="label">手动 token(可选,绕过登录测 clothing)</view>
  <input class="input" value="{{manualToken}}" bindinput="onManualToken" maxlength="500" placeholder="粘贴用后端 make_token 生成的 JWT" />

  <button type="primary" bindtap="applyManualToken">应用手动 token(写入 storage)</button>

  <button type="primary" bindtap="listClothes">3. 列衣物 GET /api/clothing</button>
  <view class="result">{{clothes || '(点上方按钮)'}}</view>
</view>
