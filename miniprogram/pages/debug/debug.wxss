.container {
  padding: 32rpx;
}
.hint {
  color: #888;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.result {
  background: #fff;
  padding: 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0 24rpx;
  word-break: break-all;
  font-size: 24rpx;
  color: #555;
  min-height: 40rpx;
}
.token {
  color: #1aad19;
}
.label {
  color: #888;
  font-size: 24rpx;
  margin: 16rpx 0 8rpx;
}
.input {
  background: #fff;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
